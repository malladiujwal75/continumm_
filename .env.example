# ============================================================
# Path A — Hindsight Cloud (recommended: zero infra, fastest to demo)
#   1. Sign up at https://ui.hindsight.vectorize.io
#   2. Click Connect -> Create API Key, copy it below
#   3. In Billing, apply promo code MEMHACK99 for $50 free credit
# ============================================================
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key

# ============================================================
# Path B — self-hosted via `docker compose up` instead of Path A.
# Leave HINDSIGHT_API_KEY blank and point at the local container:
# HINDSIGHT_BASE_URL=http://localhost:8888
# ============================================================

# ---- No-memory baseline LLM (used ONLY by the "memory off" comparison) ----
# Groq's free tier works well: https://console.groq.com
GROQ_API_KEY=your-groq-api-key
BASELINE_LLM_BASE_URL=https://api.groq.com/openai/v1
BASELINE_LLM_MODEL=openai/gpt-oss-120b

# ---- App ----
PRODUCT_NAME=Nimbus Sync
DB_PATH=continuum.db
SHARED_BANK_ID=product::known-issues
